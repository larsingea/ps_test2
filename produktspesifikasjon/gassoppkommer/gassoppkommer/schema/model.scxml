   <sc:classes>
    <sc:Class>
     <sc:name>MarinGassoppkommePkt</sc:name>
     <sc:id>C1</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>featuretype</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Datasettet viser eller indikerer gassoppkommer fra havbunnen. Detaljnivået på datasettet tilsier bruk innenfor kartmålestokken: 1:5 000 - 1:500 000.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>geometry</sc:name>
       <sc:id>C1_1</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>GM_Point</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>lokalid</sc:name>
       <sc:id>C1_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>lokalid</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>identifikasjon</sc:name>
       <sc:id>C1_3</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeId>C2</sc:typeId>
       <sc:typeName>Identifikasjon</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>datafangstdato</sc:name>
       <sc:id>C1_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato når objektet siste gang ble registrert/observert/målt i terrenget&lt;br/&gt;Merknad: I mange tilfeller er denne forskjellig fra oppdateringsdato, da registrerte endringer kan bufres i en kortere eller lengre periode før disse legges inn i databasen.&lt;br/&gt;Ved førstegangsregistrering settes Datafangstdato lik førsteDatafangstdato.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>4</sc:sequenceNumber>
       <sc:typeName>DateTime</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>oppdateringsdato</sc:name>
       <sc:id>C1_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tidspunkt for siste endring på objektet &lt;br/&gt;Merknad: &lt;br/&gt;Oppdateringsdato kan være forskjellig fra datafangsdato ved at data som er registrert kan bufres en kortere eller lengre periode før disse legges inn i datasystemet (databasen).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>5</sc:sequenceNumber>
       <sc:typeName>DateTime</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>datauttaksdato</sc:name>
       <sc:id>C1_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato for uttak fra en database&lt;br/&gt;Merknad:&lt;br/&gt;Skiller seg fra Kopidato ved at en ikke skiller på om det er uttak fra en originaldatabase eller en kopidatabase.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>6</sc:sequenceNumber>
       <sc:typeName>DateTime</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>kvalitet</sc:name>
       <sc:id>C1_7</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>7</sc:sequenceNumber>
       <sc:typeId>C3</sc:typeId>
       <sc:typeName>Posisjonskvalitet</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>medium</sc:name>
       <sc:id>C1_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Objektets beliggenhet i forhold til jordoverflaten&lt;br/&gt;Eksempel:
På bro, i tunnel, inne i et bygningsmessig anlegg, etc.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>8</sc:sequenceNumber>
       <sc:typeId>C4</sc:typeId>
       <sc:typeName>Medium</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>opphav</sc:name>
       <sc:id>C1_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Referanse til opphavsmaterialet, kildematerialet, organisasjons/publiseringskilde
&lt;br/&gt;Merknad: &lt;br/&gt;Kan også beskrive navn på person og årsak til oppdatering</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>9</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>toktNummer</sc:name>
       <sc:id>C1_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Unikt navn på måleoppdrag</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>10</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>linjeNummer</sc:name>
       <sc:id>C1_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Linjenummer i et tokt. Sammen med toktnummer gir denne et unikt navn for linjen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>11</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>datafangsttid</sc:name>
       <sc:id>C1_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Klokkeslett når objektet ble registrert/observert/målt i felt</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>12</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>vanndyp</sc:name>
       <sc:id>C1_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Vanndyp der prøven er tatt.&lt;br/&gt;-- Definition – &lt;br/&gt;Water depth where the sample is taken.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>13</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>gassøyleHøyde</sc:name>
       <sc:id>C1_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Estimert høyde på en gassøyle i vann</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>14</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>styrke</sc:name>
       <sc:id>C1_15</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Relativ styrke på akustisk signal i en gassøyle</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>15</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>pålitelighetProsent</sc:name>
       <sc:id>C1_16</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Pålitelighet i prosent (10-100) som viser hvor stor sannsynligheten er for at signaler i vannkolonnedata viser et gassoppkomme</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>16</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>geolPavisningstype</sc:name>
       <sc:id>C1_17</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Hvor sikkert et geologisk objekt er påvist i terrenget, eller hvilken metode som ligger til grunn for å påvisningen/registreringen
-- Definition -- with what certainty a geological object has been identified in the terrain, or on which method the identification/registration is based</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>17</sc:sequenceNumber>
       <sc:typeId>C5</sc:typeId>
       <sc:typeName>GeolPavisningstype</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>Identifikasjon</sc:name>
     <sc:id>C2</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>lokalId</sc:name>
       <sc:id>C2_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Lokal identifikator av et objekt&lt;br/&gt;Merknad: Det er dataleverendørens ansvar å sørge for at den lokale identifikatoren er unik innenfor navnerommet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>navnerom</sc:name>
       <sc:id>C2_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navnerom som unikt identifiserer datakilden til et objekt, anbefales å være en http-URI&lt;br/&gt;Eksempel: http://data.geonorge.no/SentraltStedsnavnsregister/1.0
&lt;br/&gt;Merknad : Verdien for nanverom vil eies av den dataprodusent som har ansvar for de unike identifikatorene og må være registrert i data.geonorge.no eller data.norge.no</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>versjonId</sc:name>
       <sc:id>C2_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Identifikasjon av en spesiell versjon av et geografisk objekt (instans)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>Posisjonskvalitet</sc:name>
